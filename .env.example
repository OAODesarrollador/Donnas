# PostgreSQL Database connection URL
# Reemplaza 'username', 'password', 'localhost', '5432' y 'central_donuts' con tus datos reales de PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/central_donuts?schema=public"

# Vercel Blob
BLOB_STORE_ID="store_xxxxxxxxxxxxxxxx"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# Admin panel test credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_SESSION_TOKEN="change-this-session-token"
